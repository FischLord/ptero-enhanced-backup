{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "peb-backups",
    "name": "PEB Backups",
    "version": "1.3.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Dashboard, Server-Status und Dateibrowser fuer das PEB-Backup-Gateway (dedupliziertes Backup-Backend fuer Pterodactyl).",
    "author": "FischLord",
    "icon": "database-backup",
    "provider": "PebBackups\\PebBackupsProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "peb",
        "screens": [
            {
                "id": "backups",
                "area": "admin",
                "path": "backups",
                "nav": { "label": "Backups", "icon": "database-backup", "order": 50 }
            },
            {
                "id": "setup",
                "area": "admin",
                "path": "setup",
                "nav": { "label": "Setup", "icon": "wand-sparkles", "order": 51 }
            },
            {
                "id": "server-backups",
                "area": "admin",
                "parent": "admin.server",
                "path": "backups",
                "nav": { "label": "Backups", "order": 50, "icon": "database-backup" }
            }
        ]
    }
}
